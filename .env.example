POSTGRES_USER=orderdesk
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_DB=orderdesk
DATABASE_URL=postgresql+psycopg://orderdesk:replace-with-a-local-random-password@localhost:5438/orderdesk
APP_ORIGIN=http://localhost:3000
OPS_APP_ORIGIN=
TUNNEL_APP_ORIGIN=
ORDERDESK_SITE=
CUSTOMER_SITE_URL=
COOKIE_SECURE=false
# Sample-data seeding and mock messages.
DEMO_MODE=true
DEMO_PASSWORD=OrderDesk-demo-2026!
NEXT_PUBLIC_API_URL=/api

# OSRM routing endpoint. Configure explicitly when DEMO_MODE=false.
ROUTING_API_URL=https://routing.openstreetmap.de/routed-car

# Optional Photon endpoint. Demo mode defaults to Komoot's public Photon instance.
GEOCODER_URL=

# Optional raster tile provider. OpenStreetMap is the default.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Local mobile login only. Set false when using verified phone sign-in.
MOBILE_LOGIN_SKIP_OTP=true
